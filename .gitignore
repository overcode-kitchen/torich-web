# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# OMC (oh-my-claudecode) local state
.omc/

# Claude Code — 팀 공유 설정/훅은 추적하고, 개인 로컬 설정은 제외
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json

# Supabase CLI local cache
supabase/.temp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.playwright-mcp/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
api.backup
app/api.backup

**/GoogleService-Info.plist
