# ============================================================
# 환경변수 배치 규칙
# ============================================================
#
# Next는 아래 순서로 .env를 읽는다. 위쪽이 이긴다.
#
#   1. 쉘 환경변수              FOO=bar npm run ...
#   2. .env.production.local
#   3. .env.local                  ← dev·build 둘 다 읽힘
#   4. .env.production             ← build:app 에서만 읽힘
#   5. .env
#
# ⚠️ 핵심: `.env.local`이 `.env.production`을 **이긴다.**
#
#   환경마다 값이 달라지는 변수를 `.env.local`에 두면, `.env.production`에
#   운영값을 적어놔도 무시되고 개발값이 앱 번들에 구워진다. 빌드는 성공하고
#   경고도 없어서 앱스토어에 올린 뒤에야 드러난다.
#   이 저장소에서 실제로 두 번 발생했다 (잘못된 API 주소, Dev GA 속성).
#
#   → 환경별로 값이 다른 변수는 `.env.local`에 절대 두지 말 것.
#
# 파일별 역할 (셋 다 .gitignore 대상 — 각자 컴퓨터에 직접 만든다):
#
#   .env.local               환경 무관 공통값        dev·build 공통
#   .env.development.local   로컬 개발 전용          `npm run dev` 에서만
#   .env.production          릴리즈 빌드 전용        `npm run build:app` 에서만
#
# ============================================================


# ------------------------------------------------------------
# .env.local — 환경 무관 공통값
# ------------------------------------------------------------
# dev에서도 build에서도 값이 같은 것만 여기 둔다.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Firebase — 웹 푸시 전용. iOS 앱은 GoogleService-Info.plist를 쓰므로 무관하다.
# 값은 Firebase Console에서 확인.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 웹 푸시를 쓸 때만 필요. 없으면 웹에서 FCM 등록을 조용히 스킵한다.
# Firebase Console > 프로젝트 설정 > Cloud Messaging > 웹 푸시 인증서(VAPID 키)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=


# ------------------------------------------------------------
# .env.development.local — 로컬 개발 전용
# ------------------------------------------------------------
# `npm run dev`에서만 읽힌다. 릴리즈 빌드에 새어나가지 않는다.

# 브라우저 개발만 하면 비워둬도 된다 (상대경로 /api/* 로 동작).
# 실기기 테스트는 `npm run dev:app`이 맥 LAN IP로 자동 설정하므로 손댈 필요 없다.
NEXT_PUBLIC_API_URL=http://localhost:3000

# GA4 Dev 속성. 개발 트래픽이 운영 지표에 섞이지 않게 한다.
NEXT_PUBLIC_GA_ID=

# 로컬 dev 서버의 app/api 라우트 전용 (update-user-rates·delete-account).
# 운영에서는 Vercel 환경변수가 공급한다. 앱 번들에는 들어가지 않는다.
# ⚠️ RLS를 전부 우회하는 마스터 키. 외부에 붙여넣지 말 것.
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------
# .env.production — 릴리즈 빌드 전용
# ------------------------------------------------------------
# `npm run build:app`에서만 읽힌다. 여기 값이 앱 번들에 구워진다.
# ⚠️ .env.local에 같은 키가 있으면 그쪽이 이겨 이 값이 무시된다.

# 앱은 이 도메인의 /api/* 를 호출한다.
# 앱 빌드 시 app/api가 제외되므로 절대 URL이어야 한다.
# 로컬 주소를 넣으면 build:app이 빌드를 중단시킨다.
NEXT_PUBLIC_API_URL=https://torich.vercel.app

# GA4 Prod 속성. 미설정 시 통계가 조용히 수집되지 않는다.
NEXT_PUBLIC_GA_ID=


# ------------------------------------------------------------
# 파일에 두지 않는 변수 (참고)
# ------------------------------------------------------------
# CAP_SERVER_URL         실기기 라이브 리로드 주소. `npm run sync:app`이 자동 설정한다.
#                        capacitor.config.ts에 직접 적으면 운영 앱이 개발자 맥을 바라본다.
# ALLOW_LOCAL_API_URL=1  build:app의 로컬 주소 차단을 우회. 실기기용 빌드에만 쓴다.
# CORS_ALLOWED_ORIGINS   API 라우트 CORS 허용 출처 추가. 필요 시 Vercel에 등록한다.
