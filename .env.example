# ============================================================
# 환경변수 템플릿
# ============================================================
#
# 이 파일을 두 번 복사해 값을 채운다. 둘 다 .gitignore 대상이다.
#
#   cp .env.example .env.development.local    # 로컬 개발용 값
#   cp .env.example .env.production           # 릴리즈 빌드용 값
#
# 두 파일은 키 구성이 같고 값만 다르다. Next가 읽는 시점이 서로 배타적이라
# 충돌하지 않는다.
#
#   .env.development.local   `npm run dev`       에서만 읽힘
#   .env.production          `npm run build:app` 에서만 읽힘
#
# ⚠️ `.env.local`은 만들지 말 것.
#
#   .env.local은 dev·build 양쪽에서 읽히고 .env.production보다 우선한다.
#   따라서 여기에 키를 두면 .env.production의 운영값이 조용히 무시되고
#   개발값이 앱 번들에 구워진다. 빌드는 성공하고 경고도 없어서,
#   앱스토어에 올린 뒤에야 드러난다. 이 저장소에서 실제로 두 번 발생했다
#   (잘못된 API 주소가 구워짐, Dev GA 속성으로 운영 데이터 유입).
#
# ============================================================


# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# app/api 라우트 전용 (update-user-rates·delete-account).
# 앱 번들에는 들어가지 않는다 (NEXT_PUBLIC_ 접두사 없음).
#   .env.development.local → 값 필요 (로컬 dev 서버가 사용)
#   .env.production        → 비워둔다 (운영 웹은 Vercel 환경변수가 공급)
# ⚠️ RLS를 전부 우회하는 마스터 키. 외부에 붙여넣지 말 것.
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------
# API 주소
# ------------------------------------------------------------
# 앱은 이 도메인의 /api/* 를 호출한다.
# 앱 빌드 시 app/api가 제외되므로 절대 URL이어야 한다.
#   .env.development.local → http://localhost:3000
#                            (실기기는 `npm run dev:app`이 맥 LAN IP로 덮어씀)
#   .env.production        → https://torich.vercel.app
# 릴리즈 빌드에 로컬 주소가 들어가면 build:app이 중단시킨다.
NEXT_PUBLIC_API_URL=


# ------------------------------------------------------------
# GA4
# ------------------------------------------------------------
# 개발 트래픽이 운영 지표에 섞이지 않도록 속성을 분리한다.
#   .env.development.local → Dev  속성 ID
#   .env.production        → Prod 속성 ID
# 미설정 시 통계가 조용히 수집되지 않는다.
NEXT_PUBLIC_GA_ID=


# ------------------------------------------------------------
# Firebase — 웹 푸시 전용
# ------------------------------------------------------------
# iOS 앱 푸시는 GoogleService-Info.plist를 쓰므로 이 값들과 무관하다.
# 값은 Firebase Console에서 확인. 두 파일 모두 같은 값을 넣는다.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 웹 푸시를 쓸 때만 필요. 없으면 웹에서 FCM 등록을 조용히 스킵한다.
# Firebase Console > 프로젝트 설정 > Cloud Messaging > 웹 푸시 인증서(VAPID 키)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=


# ------------------------------------------------------------
# 파일에 두지 않는 변수 (참고)
# ------------------------------------------------------------
# CAP_SERVER_URL         실기기 라이브 리로드 주소. `npm run sync:app`이 자동 설정한다.
#                        capacitor.config.ts에 직접 적으면 운영 앱이 개발자 맥을 바라본다.
# ALLOW_LOCAL_API_URL=1  build:app의 로컬 주소 차단을 우회. 실기기용 빌드에만 쓴다.
# CORS_ALLOWED_ORIGINS   API 라우트 CORS 허용 출처 추가. 필요 시 Vercel에 등록한다.
