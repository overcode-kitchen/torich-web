# Capacitor는 Podfile에서 node_modules 경로를 직접 참조한다.
#   pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
#
# pnpm 기본 구조(격리된 심볼릭 링크)에서는 이 경로가 아래처럼 바뀐다.
#   node_modules/.pnpm/@capacitor+ios@8.4.1_@capacitor+core@8.4.1/node_modules/@capacitor/ios
#
# 경로에 버전이 박히므로 패키지를 올릴 때마다 Podfile이 갈아엎어지고,
# 커밋하면 다른 사람 환경에서 pod install이 깨진다.
# hoisted를 쓰면 npm과 같은 평평한 구조가 되어 Podfile이 그대로 유지된다.
node-linker=hoisted
